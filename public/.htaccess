Options -MultiViews
RewriteEngine On

# If the request is for a real file or directory, serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Pass /api/* requests through to PHP (do NOT redirect to index.html)
RewriteRule ^api/ - [L]

# For everything else (React Router paths like /contact, /about, etc.)
# serve index.html so the SPA handles routing
RewriteRule ^ index.html [L]
